# ---------------------------------------------------------------------------
# Client (inlined into the browser bundle at build time — VITE_ prefix only!)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Absolute base for the /api functions when the app is served from another
# origin (e.g. the GitHub Pages mirror pointing at your Vercel backend).
# Leave empty on Vercel so calls are same-origin.
#VITE_API_BASE=https://your-app.vercel.app

# ---------------------------------------------------------------------------
# Server (Vercel: Settings > Environment Variables — never VITE_ prefixed)
# ---------------------------------------------------------------------------

# Required for accounts, trials, and billing. SUPABASE_URL may be omitted if
# VITE_SUPABASE_URL is already set in the same environment.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Signal sources — all optional. Reddit (public JSON), Hacker News,
# Stack Overflow, and Medium (RSS) work with no keys at all.
#REDDIT_CLIENT_ID=
#REDDIT_CLIENT_SECRET=
#STACKEXCHANGE_KEY=
#YOUTUBE_API_KEY=
#TWITTER_BEARER_TOKEN=

# Server-side AI for blueprints: pick OpenAI | Anthropic | Gemini.
# Users can always bring their own key instead (Model setup) for free.
#AI_PROVIDER=OpenAI
#AI_MODEL=gpt-4o-mini
#OPENAI_API_KEY=
#ANTHROPIC_API_KEY=
#GEMINI_API_KEY=

# Stripe Pro subscription.
#STRIPE_SECRET_KEY=sk_live_or_test_key
#STRIPE_PRICE_ID=price_...
#STRIPE_WEBHOOK_SECRET=whsec_...
# Public origin for Stripe redirects — only needed behind proxies.
#APP_URL=https://your-app.vercel.app
